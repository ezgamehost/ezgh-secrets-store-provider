      "filter": "displayName eq \"Ada \\\"the Countess\\\" Lovelace\"",
      "parsed": {
        "attribute": "displayName",
        "op": "eq",
        "value": "Ada \"the Countess\" Lovelace"
      }
    },
    {
      "name": "attribute names are case-insensitive",
