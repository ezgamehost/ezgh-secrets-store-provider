{
  "description": "SCIM as org-api serves it (contracts/scim.md). filters: the filter subset, parsed, or refused (invalidFilter). patches: a PatchOp request applied to a stored resource, giving the stored result or a SCIM error type. normalize: a POST or PUT body, as stored. Resources are SCIM JSON without id, schemas, meta or groups; ignored attributes never appear. Computed by scripts/lib/scim.mjs; org-api's src/scim/model.ts must give the same answers.",
  "filters": [
    {
      "name": "okta: userName eq",
      "resourceType": "User",
      "filter": "userName eq \"ada@acme.test\"",
      "parsed": {
        "attribute": "userName",
        "op": "eq",
        "value": "ada@acme.test"
      }
    },
    {
      "name": "entra: different case",
      "resourceType": "User",
      "filter": "userName eq \"ADA@Acme.Test\"",
      "parsed": {
        "attribute": "userName",
        "op": "eq",
        "value": "ADA@Acme.Test"
      }
    },
    {
      "name": "keywords in any case",
      "resourceType": "User",
      "filter": "userName EQ \"ada@acme.test\"",
      "parsed": {
        "attribute": "userName",
        "op": "eq",
        "value": "ada@acme.test"
      }
    },
