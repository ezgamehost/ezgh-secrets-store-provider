    { "pattern": "ezgh:*:org_k3f9a0x2m7qp:prj_g7h8i9j0k1l2:rep_*/team-a/api", "resource": "ezgh:us-west-1:org_k3f9a0x2m7qp:prj_g7h8i9j0k1l2:rep_7m2k9q4x0a1b/team-a/api-v2", "matches": false },
