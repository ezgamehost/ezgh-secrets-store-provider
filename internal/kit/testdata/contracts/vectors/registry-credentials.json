{
  "description": "Registry hosts' credential recognition (contracts/identity-and-authz.md, Registry credentials). authorization is the list of Authorization header values; expect is apiKey, anonymous or unauthenticated.",
  "cases": [
    { "name": "no header", "authorization": [], "cookie": "better-auth.session_token=s", "expect": "anonymous" },
    { "name": "anonymous token", "authorization": ["Bearer anonymous"], "expect": "anonymous" },
    { "name": "bearer API key", "authorization": ["Bearer ezgh_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "expect": "apiKey", "token": "ezgh_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
    { "name": "basic with API key password", "authorization": ["Basic Y2k6ZXpnaF9hYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFh"], "expect": "apiKey", "token": "ezgh_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
    { "name": "basic with empty username", "authorization": ["Basic OmV6Z2hfYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYQ=="], "expect": "apiKey", "token": "ezgh_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
    { "name": "basic without colon", "authorization": ["Basic ZXpnaF9hYWFh"], "expect": "unauthenticated" },
    { "name": "basic not base64", "authorization": ["Basic !!!"], "expect": "unauthenticated" },
    { "name": "OAuth access token", "authorization": ["Bearer ezgh_at_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "expect": "unauthenticated" },
    { "name": "SSO resource token", "authorization": ["Bearer ezgh_sat_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "expect": "unauthenticated" },
    { "name": "ingest key", "authorization": ["Bearer ezgh_ik_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "expect": "unauthenticated" },
    { "name": "basic with OAuth password", "authorization": ["Basic Y2k6ZXpnaF9hdF9hYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFh"], "expect": "unauthenticated" },
    { "name": "short key", "authorization": ["Bearer ezgh_aaaa"], "expect": "unauthenticated" },
    { "name": "two headers", "authorization": ["Bearer anonymous", "Bearer anonymous"], "expect": "unauthenticated" },
    { "name": "lowercase scheme", "authorization": ["bearer ezgh_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "expect": "unauthenticated" },
    { "name": "cookie only", "authorization": [], "cookie": "__Secure-better-auth.session_token=s", "expect": "anonymous" }
  ]
}
