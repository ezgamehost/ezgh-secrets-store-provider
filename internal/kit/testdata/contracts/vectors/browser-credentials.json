{
  "description": "[being built] A browser host's credential recognition (contracts/identity-and-authz.md, \"Observability client tokens\"; registration.md, \"Browser hosts\"). query is the raw query string; authorization is the list of Authorization header values; cookie, when present, is the Cookie header (never read). The request's Origin is taken as allowed and the token as known. expect is clientToken (the token, from exactly one ct value matching ^ezgh_ct_[A-Za-z0-9]{43}$, goes to the admission read), unauthenticated (401: checked first, after the method check and the per-address bucket) or invalid_request (400: any Authorization header beside a valid ct, answered after the Origin check).",
  "cases": [
    { "name": "a client token in ct", "query": "ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw", "authorization": [], "expect": "clientToken", "token": "ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw" },
    { "name": "with the SDK's other parameters", "query": "ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw&enc=gzip&sv=1.0.0", "authorization": [], "expect": "clientToken", "token": "ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw" },
    { "name": "through a tunnel, path included (ignored)", "query": "path=%2Fv1%2Flogs&ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw&enc=gzip", "authorization": [], "expect": "clientToken", "token": "ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw" },
    { "name": "a session cookie beside it is ignored", "query": "ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw", "authorization": [], "cookie": "__Secure-better-auth.session_token=s", "expect": "clientToken", "token": "ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw" },
    { "name": "no ct", "query": "enc=gzip", "authorization": [], "expect": "unauthenticated" },
    { "name": "no query at all", "query": "", "authorization": [], "expect": "unauthenticated" },
    { "name": "an empty ct", "query": "ct=", "authorization": [], "expect": "unauthenticated" },
    { "name": "ct twice, the same token", "query": "ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw&ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw", "authorization": [], "expect": "unauthenticated" },
    { "name": "a body one character short (42)", "query": "ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuv", "authorization": [], "expect": "unauthenticated" },
    { "name": "a body one character long (44)", "query": "ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvwx", "authorization": [], "expect": "unauthenticated" },
    { "name": "a base64url character", "query": "ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuv-", "authorization": [], "expect": "unauthenticated" },
    { "name": "an underscore", "query": "ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuv_", "authorization": [], "expect": "unauthenticated" },
    { "name": "a trailing space", "query": "ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw%20", "authorization": [], "expect": "unauthenticated" },
    { "name": "an uppercase prefix", "query": "ct=EZGH_CT_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw", "authorization": [], "expect": "unauthenticated" },
    { "name": "the prefix alone", "query": "ct=ezgh_ct_", "authorization": [], "expect": "unauthenticated" },
    { "name": "a project ingest key in ct", "query": "ct=ezgh_ik_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw", "authorization": [], "expect": "unauthenticated" },
    { "name": "an API key in ct", "query": "ct=ezgh_0123456789abcdefghijABCDEFGHIJklmnopqrst", "authorization": [], "expect": "unauthenticated" },
    { "name": "a Feature Flags client key in ct", "query": "ct=ezgh_fc_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw", "authorization": [], "expect": "unauthenticated" },
    { "name": "the token as a bearer, no ct", "query": "", "authorization": ["Bearer ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw"], "expect": "unauthenticated" },
    { "name": "a project ingest key as a bearer, no ct", "query": "", "authorization": ["Bearer ezgh_ik_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw"], "expect": "unauthenticated" },
    { "name": "a session cookie alone", "query": "", "authorization": [], "cookie": "better-auth.session_token=s", "expect": "unauthenticated" },
    { "name": "a project ingest key beside a valid ct", "query": "ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw", "authorization": ["Bearer ezgh_ik_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw"], "expect": "invalid_request" },
    { "name": "the same token as a bearer beside ct", "query": "ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw", "authorization": ["Bearer ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw"], "expect": "invalid_request" },
    { "name": "an API key beside a valid ct", "query": "ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw", "authorization": ["Bearer ezgh_0123456789abcdefghijABCDEFGHIJklmnopqrst"], "expect": "invalid_request" },
    { "name": "an empty Authorization header beside a valid ct", "query": "ct=ezgh_ct_0123456789abcdefghijABCDEFGHIJklmnopqrstuvw", "authorization": [""], "expect": "invalid_request" }
  ]
}
